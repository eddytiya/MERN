<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Details</title>
</head>
<body>

    <center>

        <h2>
            EMPLOYEE DETAILS
            &nbsp;&nbsp;
            <a href="/addEmp">ADD EMP</a>
        </h2>

        <table border="3" cellpadding="10">
            <tr>
                <th>NAME</th>
                <th>SALARY</th>
                <th>DEPARTMENT</th>
                <th>ACTIONS</th>
            </tr>

            <% data.forEach(d => { %>

                <tr>
                    <td><%= d.name %></td>
                    <td><%= d.salary %></td>
                    <td><%= d.dept %></td>

                    <td>

                        <!-- Update Button -->
                        <a href="/edit/<%= d._id %>">
                            <button type="button">Update</button>
                        </a>

                        <!-- Delete Button -->
                        <form action="/delete/<%= d._id %>?_method=DELETE"
                              method="POST"
                              style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this employee?')">

                            <button type="submit">Delete</button>

                        </form>

                    </td>
                </tr>

            <% }) %>

        </table>

    </center>

</body>
</html>