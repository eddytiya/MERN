<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Football Login</title>


<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
        font-family:'Segoe UI',sans-serif;
    }

    /* FOOTBALL STADIUM BACKGROUND */
    body{
        min-height:100vh;
        display:flex;
        justify-content:center;
        align-items:center;

        background:
            linear-gradient(
                rgba(0,0,0,0.65),
                rgba(0,0,0,0.65)
            ),
            url('https://images.unsplash.com/photo-1574629810360-7efbbe195018?auto=format&fit=crop&w=1600&q=80');

        background-size:cover;
        background-position:center;
        background-repeat:no-repeat;
    }

    /* GLASSMORPHISM CARD */
    center{
        background:rgba(255,255,255,0.15);

        backdrop-filter:blur(12px);

        width:450px;
        padding:40px;

        border-radius:20px;

        box-shadow:0 20px 40px rgba(0,0,0,0.4);

        transition:.3s;

        color:white;
    }

    center:hover{
        transform:translateY(-4px);
    }

    /* FOOTBALL ICON */
    .football-icon{
        font-size:70px;
        margin-bottom:15px;

        opacity:0.75;

        filter:drop-shadow(0 0 10px rgba(255,255,255,0.4));
    }

    /* HEADING */
    h2{
        color:white;
        text-align:center;
        font-size:32px;
        margin-bottom:25px;
    }

    form{
        text-align:left;
    }

    label{
        display:block;
        margin-bottom:8px;

        color:white;
        font-weight:600;
    }

    .form-control{
        margin-bottom:18px;
        border-radius:10px;
        padding:12px;

        border:none;
    }

    .form-control:focus{
        box-shadow:0 0 15px rgba(22,163,74,.5);
        border-color:#16a34a;
    }

    .btn-success{
        background:#16a34a;
        border:none;
        font-weight:600;
    }

    .btn-success:hover{
        background:#15803d;
    }

    .btn-dark{
        font-weight:600;
    }

    .register-link{
        margin-top:20px;
        text-align:center;
        color:white;
    }

    .register-link a{
        text-decoration:none;
        color:#22c55e;
        font-weight:700;
    }

    .register-link a:hover{
        text-decoration:underline;
    }

</style>
```

</head>
<body>


<center class="shadow-lg">

    <div class="football-icon">
        ⚽
    </div>

    <h2>Football Login</h2>

    <form action="/login" method="post">

        <label>Username</label>
        <input
            type="text"
            name="uname"
            class="form-control"
            placeholder="Enter Username"
            required>

        <label>Password</label>
        <input
            type="password"
            name="password"
            class="form-control"
            placeholder="Enter Password"
            required>

        <button type="submit" class="btn btn-success">
            Login
        </button>

        <button type="reset" class="btn btn-dark ms-2">
            Reset
        </button>

    </form>

    <div class="register-link">

        Don't have an account?

        <a href="/register" class="fw-bold">Register</a>

    </div>

</center>

</body>
</html>
