<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Profile</title>

```
<style>

    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
        font-family:'Segoe UI',sans-serif;
    }

    /* FOOTBALL STADIUM BACKGROUND */
    body{
        min-height:100vh;
        display:flex;
        justify-content:center;
        align-items:center;

        background:
            linear-gradient(
                rgba(0,0,0,0.65),
                rgba(0,0,0,0.65)
            ),
            url('https://images.unsplash.com/photo-1574629810360-7efbbe195018?auto=format&fit=crop&w=1600&q=80');

        background-size:cover;
        background-position:center;
        background-repeat:no-repeat;
    }

    /* GLASS CARD */
    .card{
        width:450px;

        background:rgba(255,255,255,0.12);

        backdrop-filter:blur(12px);

        border-radius:20px;

        padding:40px;

        box-shadow:0 15px 35px rgba(0,0,0,.4);
    }

    h2{
        color:white;
        text-align:center;
        margin-bottom:30px;
        font-size:32px;
    }

    label{
        display:block;
        color:white;
        margin-bottom:8px;
        font-weight:600;
    }

    input{
        width:100%;
        padding:12px;

        border:none;
        border-radius:10px;

        margin-bottom:20px;

        outline:none;

        font-size:15px;
    }

    input:focus{
        box-shadow:0 0 10px rgba(255,255,255,.5);
    }

    .btn{
        width:100%;
        padding:12px;

        border:none;
        border-radius:10px;

        cursor:pointer;

        font-size:16px;
        font-weight:600;

        transition:.3s;
    }

    .add-btn{
        background:#16a34a;
        color:white;
    }

    .add-btn:hover{
        background:#15803d;
    }

    .back-link{
        display:block;
        text-align:center;

        margin-top:20px;

        color:white;
        text-decoration:none;
        font-weight:600;
    }

    .back-link:hover{
        text-decoration:underline;
    }

</style>
```

</head>
<body>

```
<div class="card">

    <h2>⚽ Add Profile</h2>

    <form action="/addProfile" method="POST">

        <label>Name</label>
        <input
            type="text"
            name="name"
            placeholder="Enter Name"
            required>

        <label>Email</label>
        <input
            type="email"
            name="email"
            placeholder="Enter Email"
            required>

        <label>Age</label>
        <input
            type="number"
            name="age"
            placeholder="Enter Age"
            required>

        <button
            type="submit"
            class="btn add-btn">

            Add Profile

        </button>

    </form>

    <a href="/dashboard" class="back-link">
        ← Back to Dashboard
    </a>

</div>
```

</body>
</html>
