<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h2><center>Product</center></h2>

    
        <% pro.forEach(i => {%>
        <div style="border: 1px solid black; padding: 10px; margin: 10px;">
    <%= i.id %><br>
    <%= i.name %><br>
    <%= i.price %>
</div>
        <% }); %>
    
</body>
</html>